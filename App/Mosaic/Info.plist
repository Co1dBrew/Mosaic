<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>万象记</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Mosaic</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 这个构建有没有 iCloud/CloudKit 能力。值由 project.yml 的
	     MOSAIC_CLOUDKIT_ENABLED 注入，与 Mosaic.entitlements 必须一起改。 -->
	<key>MosaicCloudKitEnabled</key>
	<string>$(MOSAIC_CLOUDKIT_ENABLED)</string>
	<!--
	  权限说明与实际用途逐条核对过（见 PrivacyInfo.xcprivacy 的注释）：

	    相机     CameraPicker（UIImagePickerController sourceType = .camera）
	    麦克风   AudioRecorderService
	    语音识别 SpeechTranscriber（设备端，requiresOnDeviceRecognition = true）

	  **NSPhotoLibraryUsageDescription 已删除**：选图走的是 SwiftUI 的
	  `PhotosPicker`（底层 PHPickerViewController），它在**独立进程**里选片，
	  App 只拿到用户选中的那几张，**不需要相册权限**。全量 grep 确认没有
	  PHPhotoLibrary / PHAsset / sourceType = .photoLibrary 的用法。
	  留着一个用不到的用途说明，是关于本 App 行为的一句错误陈述。
	-->
	<key>NSCameraUsageDescription</key>
	<string>万象记需要使用相机来拍摄照片并加入笔记。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>万象记需要使用麦克风来录制语音笔记。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>万象记使用设备端语音识别,把你的录音转写成文字(音频不会上传)。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
